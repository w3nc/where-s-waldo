# Copy this file to .env and fill in your own values. Never commit .env.
NODE_ENV=development
PORT=3001

# Your normal (development) database
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/wheres_waldo"

# A separate database used ONLY by the tests (never point this at real data)
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/test_wheres_waldo"

# Where the React app runs (used for CORS)
CLIENT_ORIGIN="http://localhost:5173"
